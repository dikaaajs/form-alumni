# Google Sheets ID dari URL spreadsheet
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
# Nama tab (sheet) yang akan menerima data
GOOGLE_SHEETS_SHEET_NAME=Responses
# Email Service Account Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key JSON Service Account. Simpan rahasia, jangan gunakan NEXT_PUBLIC_
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"